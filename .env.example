# Copiar a .env.local y completar con los valores del proyecto Supabase.
#
#     cp .env.example .env.local
#     direnv allow          # una sola vez
#
# .env.local está en .gitignore y nunca se versiona. direnv lo carga al entrar
# a este directorio y lo descarga al salir, así que estas variables NO quedan
# en el resto de las terminales ni en los otros proyectos (ver .envrc).
#
# Los nombres son los genéricos a propósito: `SUPABASE_ACCESS_TOKEN` es el que
# lee el CLI de Supabase y `VITE_*` los que expone Vite. Ponerles prefijo
# rompería esas herramientas — el aislamiento lo da direnv, no el nombre.

# ── La app (Project Settings → API) ──────────────────────────────────────
# Estas tres las expone Vite al navegador. La anon key está pensada para ser
# pública: quien protege los datos es RLS, no el secreto de esta clave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# PowerSync → Dashboard → instancia → Instance URL
VITE_POWERSYNC_URL=https://xxxxxxxxxxxxxxxxxxxx.powersync.journeyapps.com

# Temporada activa. Se usa para denormalizar corderos.temporada y filtrar la app.
VITE_TEMPORADA=2026

# ── Solo para herramientas locales. NUNCA llegan al navegador. ───────────

# Account → Access Tokens. OJO: es de la CUENTA, no de este proyecto — da
# acceso a todos tus proyectos Supabase. Por eso no va en ~/.zshrc.
SUPABASE_ACCESS_TOKEN=

# Los ~20 caracteres del subdominio del proyecto.
SUPABASE_PROJECT_REF=

# Project Settings → API → service_role. Saltea RLS por completo.
# Solo lo usa el importador de caravanas.
SUPABASE_SERVICE_ROLE_KEY=

# Session pooler (Connect → Session pooler). Es IPv4, a diferencia de la
# conexión directa. Se usa para migraciones y tests; ver README.
POOLER_URL=
