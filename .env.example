# Copiar a .env.local y completar con los valores del Bloque 0.
# .env.local está en .gitignore — nunca se versiona.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# PowerSync → Dashboard → instancia → Instance URL
VITE_POWERSYNC_URL=https://xxxxxxxxxxxxxxxxxxxx.powersync.journeyapps.com

# Temporada activa. Se usa para denormalizar corderos.temporada y filtrar la app.
VITE_TEMPORADA=2026

# --- Solo para scripts locales (scripts/), nunca expuesto al navegador ---
# Supabase → Project Settings → API → service_role. Da acceso total, saltea RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
