# Dependencias
node_modules/

# Build
dist/
dist-ssr/
*.local

# Entorno — NUNCA versionar credenciales
.env
.env.*
!.env.example

# .envrc sí se versiona: no tiene secretos, solo carga .env.local con direnv.
# Lo que se ignora es la caché que direnv genera.
.direnv/

# Datos reales de la temporada (caravanas, exports). Se comparten fuera del repo.
datos/

# Assets de PowerSync copiados por `powersync-web copy-assets`
public/@powersync/
public/*.wasm

# Editor / SO
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Salidas de Playwright MCP (capturas de verificación)
.playwright-mcp/

# Agent skills de terceros: se instalan con `npx skills add powersync-ja/agent-skills`
.agents/
.claude/skills/
